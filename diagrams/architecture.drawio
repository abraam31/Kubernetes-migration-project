style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;collapsible=0;recursiveResize=0;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFFBF7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#B45309;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1100" height="600" as="geometry"/></mxCell><mxCell id="apps" value="&lt;b&gt;App services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;OTel SDK / instrumentation&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="eks"><mxGeometry x="20" y="60" width="240" height="64" as="geometry"/></mxCell><mxCell id="otel" value="&lt;b&gt;OTel Collector&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;receivers: otlp; exporters: SigNoz + Prometheus&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#2E8540;fillColor=#E9F5EC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="eks"><mxGeometry x="360" y="60" width="260" height="64" as="geometry"/></mxCell><mxCell id="prom" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;kube-prometheus-stack: OTLP in + scrapes&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#2E8540;fillColor=#E9F5EC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="eks"><mxGeometry x="760" y="60" width="260" height="64" as="geometry"/></mxCell><mxCell id="graf" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;dashboards&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#2E8540;fillColor=#E9F5EC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="eks"><mxGeometry x="760" y="240" width="260" height="64" as="geometry"/></mxCell><mxCell id="am" value="&lt;b&gt;Alertmanager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;ships with the stack; not used for paging&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#2E8540;fillColor=#E9F5EC;strokeWidth=1.5;fontColor=#111827;dashed=1;" vertex="1" parent="eks"><mxGeometry x="760" y="430" width="260" height="64" as="geometry"/></mxCell><mxCell id="infra" value="&lt;b&gt;Cluster metrics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;kubelet / cAdvisor, node-exporter, kube-state-metrics&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#2E8540;fillColor=#E9F5EC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="eks"><mxGeometry x="20" y="360" width="260" height="64" as="geometry"/></mxCell><mxCell id="smon" value="ServiceMonitors / PodMonitors" style="html=1;dashed=0;whiteSpace=nowrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;shape=mxgraph.kubernetes.icon;prIcon=crd;fontSize=11;" vertex="1" parent="eks"><mxGeometry x="126" y="210" width="48" height="46" as="geometry"/></mxCell><mxCell id="signoz" value="&lt;b&gt;SigNoz&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;ClickHouse storage, dashboards, alert rules&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#2E8540;fillColor=#E9F5EC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1200" y="150" width="270" height="64" as="geometry"/></mxCell><mxCell id="pd" value="&lt;b&gt;PagerDuty&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;on-call paging&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#2E8540;fillColor=#E9F5EC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1200" y="330" width="270" height="64" as="geometry"/></mxCell><mxCell id="p_obs_e1" value="&lt;b&gt;①&lt;/b&gt; OTLP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2E8540;fontSize=10;fontColor=#2E8540;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="apps" target="otel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_obs_e2" value="&lt;b&gt;②&lt;/b&gt; OTLP export (app + cluster telemetry)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2E8540;fontSize=10;fontColor=#2E8540;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="otel" target="signoz"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="120"/><mxPoint x="1335" y="120"/></Array></mxGeometry></mxCell><mxCell id="p_obs_e3" value="&lt;b&gt;③&lt;/b&gt; OTLP push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2E8540;fontSize=10;fontColor=#2E8540;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="otel" target="prom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_obs_e4" value="&lt;b&gt;④&lt;/b&gt; scraped (pull)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2E8540;fontSize=10;fontColor=#2E8540;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="infra" target="prom"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="482"/><mxPoint x="720" y="201"/></Array></mxGeometry></mxCell><mxCell id="p_obs_e5" value="select scrape targets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2E8540;fontSize=10;fontColor=#2E8540;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="smon" target="infra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_obs_e6" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2E8540;fontSize=10;fontColor=#2E8540;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="graf" target="prom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_obs_e7" value="rules (if any)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2E8540;fontSize=10;fontColor=#2E8540;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prom" target="am"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="182"/><mxPoint x="1080" y="552"/></Array></mxGeometry></mxCell><mxCell id="p_obs_e8" value="&lt;b&gt;⑤&lt;/b&gt; alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2E8540;fontSize=10;fontColor=#2E8540;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="signoz" target="pd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_obs_n9" value="&lt;b&gt;Migration status:&lt;/b&gt; moving from SigNoz (ClickHouse) to Prometheus + Grafana. Both stay populated via the collector. Alerting has not moved: SigNoz still pages PagerDuty." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="1"><mxGeometry x="1200" y="450" width="520" height="70" as="geometry"/></mxCell><mxCell id="p_obs_n10" value="&lt;b&gt;Naming gotcha:&lt;/b&gt; OTel metric names are translated for Prometheus: dots become underscores and unit / type suffixes get appended (e.g. http.server.duration becomes http_server_duration_milliseconds_bucket). Dashboards and PromQL must use the translated names." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="1"><mxGeometry x="1200" y="540" width="520" height="90" as="geometry"/></mxCell><mxCell id="p_obs_n11" value="&lt;b&gt;Alerting:&lt;/b&gt; Alertmanager has no PagerDuty receiver, so Prometheus alerts page no one. Keep SigNoz until alert rules and routing are migrated." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="1"><mxGeometry x="1200" y="650" width="520" height="70" as="geometry"/></mxCell><mxCell id="p_obs_lg12" value="Legend" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;collapsible=0;recursiveResize=0;strokeColor=#4B5563;fillColor=#F9FAFB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="190" height="184" as="geometry"/></mxCell><mxCell id="p_obs_lgl13" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#1E6FD9;shape=line;" vertex="1" parent="p_obs_lg12"><mxGeometry x="12" y="36" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_obs_lgt14" value="Delivery / GitOps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_obs_lg12"><mxGeometry x="54" y="30" width="130" height="18" as="geometry"/></mxCell><mxCell