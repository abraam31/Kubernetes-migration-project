 gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_title" value="&lt;b&gt;5. Scaling: pods (HPA / KEDA / VPA) and nodes (Karpenter)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_sub" value="HPA (CPU / memory) or KEDA (external events) change replica count, VPA only recommends requests, and Karpenter adds or removes EC2 nodes when pods do not fit." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="22" as="geometry"/></mxCell><mxCell id="a" value="Pod scaling" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;dashed=1;strokeColor=#ED7100;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="860" height="640" as="geometry"/></mxCell><mxCell id="ms" value="&lt;b&gt;metrics-server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;resource metrics API&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#ED7100;fillColor=#FFF1E5;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="a"><mxGeometry x="20" y="50" width="200" height="60" as="geometry"/></mxCell><mxCell id="hpa" value="&lt;b&gt;HPA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;min / max replicas, target utilization&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#ED7100;fillColor=#FFF1E5;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="a"><mxGeometry x="300" y="50" width="230" height="60" as="geometry"/></mxCell><mxCell id="ro" value="&lt;b&gt;Rollout / Deployment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;spec.replicas&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="a"><mxGeometry x="610" y="50" width="230" height="60" as="geometry"/></mxCell><mxCell id="evt" value="External events&lt;br&gt;(e.g. queue depth)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="a"><mxGeometry x="94" y="180" width="52" height="52" as="geometry"/></mxCell><mxCell id="keda" value="&lt;b&gt;KEDA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;ScaledObject trigger, creates its own HPA, can scale to 0&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#ED7100;fillColor=#FFF1E5;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="a"><mxGeometry x="300" y="170" width="230" height="64" as="geometry"/></mxCell><mxCell id="vprec" value="&lt;b&gt;VPA recommender&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;learns from usage history&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#ED7100;fillColor=#FFF1E5;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="a"><mxGeometry x="20" y="330" width="200" height="60" as="geometry"/></mxCell><mxCell id="vpa" value="&lt;b&gt;VPA (Off mode)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;recommendations only, changes nothing&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#ED7100;fillColor=#FFF1E5;strokeWidth=1.5;fontColor=#111827;dashed=1;" vertex="1" parent="a"><mxGeometry x="300" y="330" width="230" height="60" as="geometry"/></mxCell><mxCell id="pods" value="Pods: requests / limits" style="html=1;dashed=0;whiteSpace=nowrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.kubernetes.icon;prIcon=pod;fontSize=11;" vertex="1" parent="a"><mxGeometry x="701" y="336" width="48" height="46" as="geometry"/></mxCell><mxCell id="p_scaling_e1" value="&lt;b&gt;①&lt;/b&gt; CPU / memory" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="ms" target="hpa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e2" value="&lt;b&gt;②&lt;/b&gt; sets replicas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="hpa" target="ro"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e3" value="&lt;b&gt;③&lt;/b&gt; creates pods" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="ro" target="pods"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e4" value="recommendation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="vprec" target="vpa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e5" value="polls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt" target="keda"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e6" value="sets replicas (via its HPA)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="keda" target="ro"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="699" y="292"/></Array></mxGeometry></mxCell><mxCell id="p_scaling_e7" value="observes usage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="vpa" target="pods"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_n8" value="&lt;b&gt;One autoscaler per workload:&lt;/b&gt; plain HPA &lt;i&gt;or&lt;/i&gt; KEDA, never both (KEDA creates its own HPA). VPA stays in Off mode: in Auto it would change requests and fight HPA. Leave replicas unset in Git so ArgoCD does not reset them." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="a"><mxGeometry x="20" y="470" width="820" height="80" as="geometry"/></mxCell><mxCell id="b" value="Node scaling (Karpenter)" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;dashed=1;strokeColor=#ED7100;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="920" y="90" width="860" height="640" as="geometry"/></mxCell><mxCell id="pend" value="Pending pods (unschedulable)" style="html=1;dashed=0;whiteSpace=nowrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.kubernetes.icon;prIcon=pod;fontSize=11;" vertex="1" parent="b"><mxGeometry x="30" y="56" width="48" height="46" as="geometry"/></mxCell><mxCell id="karp" value="&lt;b&gt;Karpenter controller&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;batches pending pods, picks instance types&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#ED7100;fillColor=#FFF1E5;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="b"><mxGeometry x="190" y="50" width="250" height="60" as="geometry"/></mxCell><mxCell id="np" value="NodePool&lt;br&gt;requirements, limits, disruption" style="html=1;dashed=0;whiteSpace=nowrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.kubernetes.icon;prIcon=crd;fontSize=11;" vertex="1" parent="b"><mxGeometry x="526" y="56" width="48" height="46" as="geometry"/></mxCell><mxCell id="nc" value="EC2NodeClass&lt;br&gt;AMI, subnets, SGs, node role" style="html=1;dashed=0;whiteSpace=nowrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.kubernetes.icon;prIcon=crd;fontSize=11;" vertex="1" parent="b"><mxGeometry x="726" y="56" width="48" height="46" as="geometry"/></mxCell><mxCell id="ec2" value="EC2 instance (CreateFleet via IRSA)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="b"><mxGeometry x="289" y="230" width="52" height="52" as="geometry"/></mxCell><mxCell id="node" value="Node joins, pods scheduled" style="html=1;dashed=0;whiteSpace=nowrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.kubernetes.icon;prIcon=node;fontSize=11;" vertex="1" parent="b"><mxGeometry x="291" y="390" width="48" height="46" as="geometry"/></mxCell><mxCell id="cons" value="&lt;b&gt;Consolidation / disruption&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;empty or underused nodes drained and removed&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#ED7100;fillColor=#FFF1E5;strokeWidth=1.5;fontColor=#111827;dashed=1;" vertex="1" parent="b"><mxGeometry x="520" y="380" width="300" height="60" as="geometry"/></mxCell><mxCell id="p_scaling_e9" value="&lt;b&gt;⑤&lt;/b&gt; triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="pend" target="karp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e10" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="karp" target="np"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e11" value="references" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="np" target="nc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e12" value="&lt;b&gt;⑥&lt;/b&gt; launch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="karp" target="ec2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e13" value="&lt;b&gt;⑦&lt;/b&gt; registers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="ec2" target="node"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e14" value="continuous" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="karp" target="cons"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1335" y="290"/><mxPoint x="1590" y="290"/></Array></mxGeometry></mxCell><mxCell id="p_scaling_e15" value="drains (respects PDBs)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cons" target="node"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_scaling_e16" value="&l