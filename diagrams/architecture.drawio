2;fontColor=#8C4FFF;" vertex="1" parent="eks"><mxGeometry x="620" y="40" width="560" height="460" as="geometry"/></mxCell><mxCell id="albc" value="&lt;b&gt;aws-load-balancer-controller&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;keeps target group in sync with pod IPs&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#8C4FFF;fillColor=#F1EAFF;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="la"><mxGeometry x="30" y="140" width="230" height="60" as="geometry"/></mxCell><mxCell id="tgb" value="TargetGroupBinding&lt;br&gt;Service to target group ARN" style="html=1;dashed=0;whiteSpace=nowrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.kubernetes.icon;prIcon=crd;fontSize=11;" vertex="1" parent="la"><mxGeometry x="450" y="146" width="48" height="46" as="geometry"/></mxCell><mxCell id="pods2" value="ALB-attached pods" style="html=1;dashed=0;whiteSpace=nowrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;shape=mxgraph.kubernetes.icon;prIcon=pod;fontSize=11;" vertex="1" parent="la"><mxGeometry x="266" y="360" width="48" height="46" as="geometry"/></mxCell><mxCell id="p_traffic_e1" value="resolve hostname" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="r53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="106" y="94"/></Array></mxGeometry></mxCell><mxCell id="p_traffic_e2" value="HTTPS (REST)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="lbn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="666" y="145"/><mxPoint x="450" y="145"/></Array></mxGeometry></mxCell><mxCell id="p_traffic_e3" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="alb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="686" y="155"/><mxPoint x="950" y="155"/></Array></mxGeometry></mxCell><mxCell id="p_traffic_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="lbn" target="nginx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_traffic_e5" value="match host / path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="nginx" target="svc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_traffic_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="svc" target="pods1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_traffic_e7" value="reads rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="nginx" target="ing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_traffic_e8" value="straight to pod IPs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="pods2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_traffic_e9" value="watched by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tgb" target="albc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_traffic_e10" value="registers / deregisters pod IPs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="albc" target="alb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="250"/><mxPoint x="934" y="250"/></Array></mxGeometry></mxCell><mxCell id="p_traffic_e11" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4B5563;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tfa" target="alb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_traffic_n12" value="&lt;b&gt;Why IP targets:&lt;/b&gt; the ALB sends traffic straight to pod IPs, skipping the NodePort / &lt;span style=&quot;white-space:nowrap&quot;&gt;kube-proxy&lt;/span&gt; hop. Targets track pods, not nodes, which suits Karpenter replacing nodes. aws-load-balancer-controller authenticates with IRSA (page 4)." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="1"><mxGeometry x="1290" y="140" width="480" height="100" as="geometry"/></mxCell><mxCell id="p_traffic_n13" value="&lt;b&gt;Readiness gates:&lt;/b&gt; enabled. A new pod counts as Ready only after it passes the ALB health check, so rollouts wait for healthy targets." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="1"><mxGeometry x="1290" y="260" width="480" height="70" as="geometry"/></mxCell><mxCell id="p_traffic_n14" value="&lt;b&gt;Ownership:&lt;/b&gt; Terraform owns each ALB and its target groups; a TargetGroupBinding links a Service to its target group ARN. The ingress-nginx load balancer was set up once by hand, outside Terraform." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="1"><mxGeometry x="1290" y="350" width="480" height="90" as="geometry"/></mxCell><mxCell id="p_traffic_n15" value="&lt;b&gt;DNS:&lt;/b&gt; Route 53 records are managed by hand, including blue-green preview hostnames. external-dns is not used." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="1"><mxGeometry x="1290" y="460" width="480" height="60" as="geometry"/></mxCell><mxCell id="p_traffic_lg16" value="Legend" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;collapsible=0;recursiveResize=0;strokeColor=#4B5563;fillColor=#F9FAFB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1290" y="550" width="190" height="184" as="geometry"/></mxCell><mxCell id="p_traffic_lgl17" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#1E6FD9;shape=line;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="12" y="36" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_traffic_lgt18" value="Delivery / GitOps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="54" y="30" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_traffic_lgl19" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#8C4FFF;shape=line;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="12" y="58" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_traffic_lgt20" value="Traffic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="54" y="52" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_traffic_lgl21" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#DD344C;shape=line;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="12" y="80" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_traffic_lgt22" value="Secrets / IAM" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="54" y="74" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_traffic_lgl23" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#ED7100;shape=line;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="12" y="102" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_traffic_lgt24" value="Scaling" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="54" y="96" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_traffic_lgl25" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E8540;shape=line;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="12" y="124" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_traffic_lgt26" value="Observability" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="54" y="118" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_traffic_lgl27" value="" style="html=1;strokeWidth=2;strokeColor=#4B5563;shape=line;dashed=1;dashPattern=6 4;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="12" y="146" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_traffic_lgt28" value="Control plane / config" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="54" y="140" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_traffic_lgn29" value="" style="shape=note;size=6;fillColor=#FFF7D6;strokeColor=#D6B656;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="18" y="162" width="20" height="18" as="geometry"/></mxCell><mxCell id="p_traffic_lgt30" value="Assumption to verify" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_traffic_lg16"><mxGeometry x="54" y="162" width="130" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Secrets &amp; IAM" id="p_iam"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1330" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_title" value="&lt;b&gt;4. Secrets and IAM: IRSA and External Secrets Operator&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_sub" value="No static AWS keys in the cluster. Each controller has its own IAM role, assumed through its ServiceAccount (IRSA). Secrets live in AWS and are synced into Kubernetes by ESO." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="22" as="geometry"/></mxCell><mxCell id="a" value="How IRSA works" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;collapsible=0;recursiveResize=0;strokeColor=#4B5563;fillColor=#F9FAFB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1060" height="330" as="geometry"/></mxCell><mxCell id="tf" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;OIDC provider, one IAM role per controller, trust policy pinned to namespace:serviceaccount&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#4B5563;fillColor=#F3F4F6;strokeWidth=1.5;fo