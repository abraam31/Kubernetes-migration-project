" height="6" as="geometry"/></mxCell><mxCell id="p_scaling_lgt22" value="Traffic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_scaling_lg18"><mxGeometry x="54" y="52" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_scaling_lgl23" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#DD344C;shape=line;" vertex="1" parent="p_scaling_lg18"><mxGeometry x="12" y="80" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_scaling_lgt24" value="Secrets / IAM" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_scaling_lg18"><mxGeometry x="54" y="74" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_scaling_lgl25" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#ED7100;shape=line;" vertex="1" parent="p_scaling_lg18"><mxGeometry x="12" y="102" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_scaling_lgt26" value="Scaling" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_scaling_lg18"><mxGeometry x="54" y="96" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_scaling_lgl27" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E8540;shape=line;" vertex="1" parent="p_scaling_lg18"><mxGeometry x="12" y="124" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_scaling_lgt28" value="Observability" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_scaling_lg18"><mxGeometry x="54" y="118" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_scaling_lgl29" value="" style="html=1;strokeWidth=2;strokeColor=#4B5563;shape=line;dashed=1;dashPattern=6 4;" vertex="1" parent="p_sca