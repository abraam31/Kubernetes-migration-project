&gt;1. CI/CD and GitOps: from commit to running pod&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_sub" value="Images are built by self-hosted ARC runners, pushed to ECR, committed to Git by argocd-image-updater and rolled out by ArgoCD. Git is the source of truth, including the live image tag." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="22" as="geometry"/></mxCell><mxCell id="gh" value="GitHub" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;collapsible=0;recursiveResize=0;strokeColor=#4B5563;fillColor=#F9FAFB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1760" height="170" as="geometry"/></mxCell><mxCell id="eng" value="Engineer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" vertex="1" parent="gh"><mxGeometry x="40" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;Service repo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;app code, Dockerfile, workflow&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#4B5563;fillColor=#F3F4F6;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="gh"><mxGeometry x="210" y="50" width="230" height="60" as="geometry"/></mxCell><mxCell id="wf" value="&lt;b&gt;GitHub Actions workflow&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;runs-on: ARC scale-set label&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#1E6FD9;fillColor=#E8F1FC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="gh"><mxGeometry x="500" y="50" width="240" height="60" as="geometry"/></mxCell><mxCell id="rimg" value="&lt;b&gt;Runner images repo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;custom ARC runner images&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#4B5563;fillColor=#F3F4F6;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="gh"><mxGeometry x="800" y="50" width="230" height="60" as="geometry"/></mxCell><mxCell id="gitops" value="&lt;b&gt;GitOps repo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;Helm chart, values per env, ArgoCD Applications&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#1E6FD9;fillColor=#E8F1FC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="gh"><mxGeometry x="1280" y="50" width="280" height="60" as="geometry"/></mxCell><mxCell id="aws" value="AWS account" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1760" height="670" as="geometry"/></mxCell><mxCell id="ecr" value="Amazon ECR&lt;br&gt;repo per service" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=4;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="aws"><mxGeometry x="914" y="40" width="52" height="52" as="geometry"/></mxCell><mxCell id="eks" value="Amazon EKS cluster" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;collapsible=0;recursiveResize=0;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFFBF7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#B45309;" vertex="1" parent="aws"><mxGeometry x="20" y="150" width="1720" height="500" as="geometry"/></mxCell><mxCell id="arcc" value="&lt;b&gt;ARC controller + listener&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;gha-runner-scale-set&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#1E6FD9;fillColor=#E8F1FC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="eks"><mxGeometry x="480" y="50" width="240" height="60" as="geometry"/></mxCell><mxCell id="runner" value="&lt;b&gt;Ephemeral runner pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;custom image, Docker-in-Docker build&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#1E6FD9;fillColor=#E8F1FC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="eks"><mxGeometry x="480" y="180" width="240" height="64" as="geometry"/></mxCell><mxCell id="iu" value="&lt;b&gt;argocd-image-updater&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;git write-back to GitOps repo&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#1E6FD9;fillColor=#E8F1FC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="eks"><mxGeometry x="800" y="120" width="240" height="60" as="geometry"/></mxCell><mxCell id="argocd" value="&lt;b&gt;ArgoCD application-controller&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;helm template, diff, apply&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#1E6FD9;fillColor=#E8F1FC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="eks"><mxGeometry x="1260" y="50" width="280" height="60" as="geometry"/></mxCell><mxCell id="ro" value="&lt;b&gt;Rollout / Deployment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;pod spec gets the new image tag&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="eks"><mxGeometry x="1260" y="190" width="280" height="60" as="geometry"/></mxCell><mxCell id="pods" value="Pods (new version)" style="html=1;dashed=0;whiteSpace=nowrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.kubernetes.icon;prIcon=pod;fontSize=11;" vertex="1" parent="eks"><mxGeometry x="1620" y="196" width="48" height="46" as="geometry"/></mxCell><mxCell id="p_cicd_e1" value="&lt;b&gt;①&lt;/b&gt; push / merge PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="eng" target="repo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_cicd_e2" value="&lt;b&gt;②&lt;/b&gt; triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="repo" target="wf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_cicd_e3" value="&lt;b&gt;③&lt;/b&gt; job queued for scale set" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="wf" target="arcc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_cicd_e4" value="&lt;b&gt;④&lt;/b&gt; creates runner pod" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="arcc" target="runner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_cicd_e5" value="&lt;b&gt;⑤&lt;/b&gt; docker push :tag (IRSA)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="runner" target="ecr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="652"/><mxPoint x="800" y="420"/><mxPoint x="934" y="420"/></Array></mxGeometry></mxCell><mxCell id="p_cicd_e6" value="&lt;b&gt;⑥&lt;/b&gt; poll new tags (IRSA, read only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="iu" target="ecr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_cicd_e7" value="&lt;b&gt;⑦&lt;/b&gt; commit new tag (git)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iu" target="gitops"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="590"/><mxPoint x="1200" y="170"/></Array></mxGeometry></mxCell><mxCell id="p_cicd_e8" value="&lt;b&gt;⑧&lt;/b&gt; poll / webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="argocd" target="gitops"><mxGeometry x="-0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_cicd_e9" value="&lt;b&gt;⑨&lt;/b&gt; sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="argocd" target="ro"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_cicd_e10" value="&lt;b&gt;⑩&lt;/b&gt; roll out (page 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="ro" target="pods"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_cicd_e11" value="image pull (node IAM role)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4B5563;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="pods" target="ecr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1684" y="372"/></Array></mxGeometry></mxCell><mxCell id="p_cicd_n12" value="&lt;b&gt;Runners:&lt;/b&gt; ephemeral pods, one per job, building with Docker-in-Docker (privileged). Runner images are custom and built from the runner images repo." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="eks"><mxGeometry x="40" y="330" width="420" height="80" as="geometry"/></mxCell><mxCell id="p_cicd_n13" value="&lt;b&gt;Rollback:&lt;/b&gt; a plain revert of the tag commit does not stick: image-updater re-commits the newest matching tag. Pin the tag or remove it from ECR first." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="eks"><mxGeometry x="720" y="330" width="420" height="80" as="geometry"/></mxCell><mxCell id="p_cicd_n14" value="&lt;b&gt;Gotcha:&lt;/b&gt; ArgoCD selfHeal reverts manual kubectl edits. Change things through the GitOps repo (or the image-updater / Rollouts paths), not on the live cluster." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#1E1B4B;" vertex="1" parent="eks"><mxGeometry x="1220" y="320" width="460" height="80" as="geometry"/></mxCell><mxCell id="p_cicd_lg15" value="Legend" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;collapsible=0;recursiveResize=0;strokeColor=#4B5563;fillColor=#F9FAFB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1590" y="975" width="190" height="184" as="geometry"/></mxCell><mxCell id="p_cicd_lgl16" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#1E6FD9;shape=line;" vertex="1" parent="p_cicd_lg15"><mxGeometry x="12" y="36" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_cicd_lgt17" value="Delivery / GitOps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_cicd_lg15"><mxGeometry x="54" y="30" width="130" height="18" as=