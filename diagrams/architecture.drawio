/mxCell><mxCell id="p_cicd_lgl26" value="" style="html=1;strokeWidth=2;strokeColor=#4B5563;shape=line;dashed=1;dashPattern=6 4;" vertex="1" parent="p_cicd_lg15"><mxGeometry x="12" y="146" width="34" height="6" as="geometry"/></mxCell><mxCell id="p_cicd_lgt27" value="Control plane / config" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_cicd_lg15"><mxGeometry x="54" y="140" width="130" height="18" as="geometry"/></mxCell><mxCell id="p_cicd_lgn28" value="" style="shape=note;size=6;fillColor=#FFF7D6;strokeColor=#D6B656;" vertex="1" parent="p_cicd_lg15"><mxGeometry x="18" y="162" width="20" height="18" as="geometry"/></mxCell><mxCell id="p_cicd_lgt29" value="Assumption to verify" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="p_cicd_lg15"><mxGeometry x="54" y="162" width="130" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Progressive delivery" id="p_rollouts"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_title" value="&lt;b&gt;2. Progressive delivery with Argo Rollouts&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_sub" value="Canary for backend services (no public exposure), blue-green for services tested through their own preview ingress. A human promotes or aborts every release." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="22" as="geometry"/></mxCell><mxCell id="argocd" value="&lt;b&gt;ArgoCD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;syncs the new image tag&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#1E6FD9;fillColor=#E8F1FC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="60" as="geometry"/></mxCell><mxCell id="rcr" value="&lt;b&gt;Rollout (CR)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;strategy: canary or blueGreen&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="240" height="60" as="geometry"/></mxCell><mxCell id="rctl" value="&lt;b&gt;Argo Rollouts controller&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;creates and scales ReplicaSets&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#1E6FD9;fillColor=#E8F1FC;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="260" height="60" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;Operator: promote / abort&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;ArgoCD UI extension or kubectl argo rollouts&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;strokeColor=#4B5563;fillColor=#F3F4F6;strokeWidth=1.5;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="300" height="60" as="geometry"/></mxCell><mxCell id="p_rollouts_e1" value="sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="argocd" target="rcr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_rollouts_e2" value="reconciled by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="rcr" target="rctl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_rollouts_e3" value="promote / abort" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4B5563;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="rctl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="can" value="Canary: backend services, no public exposure" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;dashed=1;strokeColor=#1E6FD9;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontColor=#1E6FD9;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="840" height="630" as="geometry"/></mxCell><mxCell id="p_rollouts_e4" value="canary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1E6FD9;fontSize=10;fontColor=#1E6FD9;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rctl" target="can"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="715" y="195"/><mxPoint x="440" y="195"/></Array></mxGeometry></mxCell><mxCell id="caller" value="&lt;b&gt;Calling services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color